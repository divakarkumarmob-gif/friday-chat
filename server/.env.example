# ==============================================================================
# Friday Chat Server - Environment Configuration Template
# Copy this file to .env before starting the server:
# cp .env.example .env
# ==============================================================================

# Server HTTP & WebSocket Port
PORT=8080

# PostgreSQL Database Connection URL (Relational: Auth, Profiles, Contacts, E2EE Keys, Device Tokens)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
POSTGRES_URL=postgres://chat_user:chat_password@localhost:5432/friday_chat_db?sslmode=disable

# Apache Cassandra Distributed Database (Time-Series Message History)
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=friday_chat

# Firebase Cloud Messaging (FCM HTTP v1 Push Notifications)
FCM_PROJECT_ID=friday-chat-app
FCM_SERVER_KEY=ya29.c.b0...your_oauth2_or_server_key_here...

# JWT Authentication Secret Key (Used for signing & verifying user session tokens)
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_9812479218
